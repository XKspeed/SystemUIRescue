<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层。
  画布 108×108，图形压在中心，圆形 / 方圆形 / 水滴形遮罩都不会切到。

  构图（对齐用户选定方案）：
  - 270° 白环，缺口在右上 90°（保留原版构图）
  - 绿点落在缺口 90° 的正中间（圆心正上顺时针 45°、与环同半径的弧线上）
  - 细环 + 小尺寸：环半径 21.3、线宽 8，整体外径 ≈ 25.3，
    约为原版（32）的 80%（用户在原 60% 变体 B 基础上放大到 80%）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 270° 白环：缺口在右上，线宽更细 -->
    <path
        android:pathData="M54,32.7 A21.3,21.3 0 1,0 75.3,54"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- 绿点：落在缺口正中 -->
    <path
        android:pathData="M69.1,34.2 a4.7,4.7 0 1,0 0,9.4 a4.7,4.7 0 1,0 0,-9.4 Z"
        android:fillColor="#3DDC84" />
</vector>
